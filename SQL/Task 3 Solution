C. Logical Operators – AND
SELECT * FROM Customers WHERE City = "Mumbai" AND Age >25;
SELECT * FROM Customers WHERE Age>30 AND Account_Balance > 70000;
SELECT * FROM Customers WHERE Gender = "F" AND City = "Delhi";
SELECT * FROM Customers WHERE City = "Pune" AND Account_Balance > 40000;

D. Logical Operators – OR
SELECT * FROM Customers WHERE City = "Mumbai" OR City = "Delhi";
SELECT * FROM Customers WHERE Age <25 OR Age > 40;
SELECT * FROM Customers WHERE City = "Pune" OR City = "Bangalore";
SELECT * FROM Customers WHERE Account_Balance > 100000 OR Age > 40;

E. Logical Operators – NOT
SELECT * FROM Customers WHERE NOT City = "Mumbai";
SELECT * FROM Customers WHERE NOT Age = 30;
SELECT * FROM Customers WHERE NOT Gender ="F";
SELECT * FROM Customers WHERE NOT City = "Delhi" ;

F. BETWEEN
SELECT * FROM Customers WHERE Age BETWEEN 25 AND 35;
SELECT * FROM Customers WHERE Account_Balance BETWEEN 40000 AND 70000;
SELECT * FROM Customers WHERE Registration_Date BETWEEN "2025-03-01" AND "2025-06-30";
SELECT * FROM Customers WHERE NOT Age BETWEEN 25 AND 35;

G. LIKE
SELECT * FROM Customers WHERE Customer_Name LIKE "A%";
SELECT * FROM Customers WHERE Customer_Name LIKE "%a";
SELECT * FROM Customers WHERE Customer_Name LIKE "%an%";
SELECT * FROM Customers WHERE Customer_Name LIKE "%sh%";
SELECT * FROM Customers WHERE Customer_Name LIKE "M%";
SELECT * FROM Customers WHERE Customer_Name LIKE "_____";
