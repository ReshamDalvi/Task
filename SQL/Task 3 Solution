SELECT * FROM Customers WHERE Customer_Name LIKE "A__";
SELECT * FROM Customers WHERE City LIKE "M%";
SELECT * FROM Customers WHERE Email LIKE "%@gmail.com";

H. IS NULL / IS NOT NULL
SELECT * FROM Customers WHERE Phone IS NULL;
SELECT * FROM Customers WHERE NOT Phone IS NULL;
SELECT * FROM Customers WHERE NOT Registration_Date IS NULL;
SELECT * FROM Customers WHERE Gender IS NULL;

I. DISTINCT
SELECT DISTINCT City FROM Customers;
SELECT DISTINCT Gender FROM Customers;
SELECT DISTINCT Age FROM Customers;
SELECT DISTINCT City , Gender FROM Customers;

J. Aggregate Functions
SELECT SUM(Customer_ID) AS Total_Customers FROM Customers;
SELECT SUM(Account_Balance) AS Total_Balance FROM Customers;
SELECT AVG(Account_Balance) AS Average_Balance FROM Customers;
SELECT MIN(Account_Balance) AS Minimum_Balance FROM Customers;
SELECT MAX(Account_Balance) AS Maximum_Balance FROM Customers;
SELECT COUNT(Gender) AS Total_Male FROM Customers WHERE Gender ="M";
SELECT COUNT(Gender) AS Total_Female FROM Customers WHERE Gender ="F";
SELECT AVG(Age) AS Average_Age FROM Customers;

# K. GROUP BY
SELECT City, SUM(Customer_ID) AS Total_Customers FROM Customers GROUP BY City;
SELECT City, SUM(Account_Balance) AS Total_Bal FROM Customers GROUP BY City;
SELECT City, AVG(Account_Balance) AS Average_Bal FROM Customers GROUP BY City;
SELECT City, MAX(Account_Balance) AS Maximum_Bal FROM Customers GROUP BY City;
SELECT City, MIN(Account_Balance) AS Minimum_Bal FROM Customers GROUP BY City;
SELECT Gender, COUNT(Customer_ID) AS Total_Cust FROM Customers GROUP BY Gender;
SELECT Gender, AVG(Age) AS Avg_Age FROM Customers GROUP BY Gender;
SELECT Gender, SUM(Account_Balance) AS Total_Bal FROM Customers GROUP BY Gender;

# L. GROUP BY + HAVING
SELECT City, COUNT(Customer_ID) AS Total_Cust FROM Customers GROUP BY City HAVING Total_Cust > 3;
SELECT City, SUM(Account_Balance) AS Total_Bal FROM Customers GROUP BY City HAVING Total_Bal > 200000;
SELECT City, AVG(Account_Balance) AS Avg_Bal FROM Customers GROUP BY City HAVING Avg_Bal > 60000;
SELECT Gender, COUNT(Customer_ID) AS Total_Cust FROM Customers GROUP BY Gender HAVING Total_Cust > 20;
